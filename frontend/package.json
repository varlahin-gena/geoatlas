{
  "name": "geoatlas-frontend",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "knip": "knip",
    "openapi:types": "openapi-typescript ../openapi.yaml -o src/api/openapi.d.ts",
    "openapi:check": "openapi-typescript ../openapi.yaml -o src/api/openapi.d.ts && git diff --exit-code -- src/api/openapi.d.ts"
  },
  "dependencies": {
    "@deck.gl/core": "9.1.15",
    "@deck.gl/layers": "9.1.15",
    "@deck.gl/mapbox": "9.1.15",
    "maplibre-gl": "5.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
