# Пример переменных стека. Не копируйте «как есть» в прод и не коммитьте заполненный .env.
# Секреты (API_AUTH_TOKEN, SESSION_SECRET, AUTH_ADMIN_PASSWORD, CLICKHOUSE_PASSWORD)
# генерирует ./start.sh / установщик.

HTTP_PORT=80
HTTPS_ENABLED=auto
HTTPS_PORT=443
HTTP_REDIRECT=1
COMPOSE_PROFILES=syslog,stats

