# Пример переменных стека. Не копируйте «как есть» в прод и не коммитьте заполненный .env.
# Секреты (API_AUTH_TOKEN, API_OPS_TOKEN, SESSION_SECRET, AUTH_ADMIN_PASSWORD,
# CLICKHOUSE_PASSWORD, INGEST_SHARED_SECRET) генерирует ./start.sh / установщик.
#
# API_OPS_TOKEN — Bearer scope=ops для sidecars (stats-collector). Не даёт admin.

HTTP_PORT=80
HTTPS_ENABLED=auto
HTTPS_PORT=443
HTTP_REDIRECT=1
COMPOSE_PROFILES=syslog,stats

# AUTH_ADMIN_USER=admin
# AUTH_DISABLED=false
# API_AUTH_DISABLED=false
# REPUTATION_FETCH_ENABLED=true
# NM_ALLOW_INSECURE=0
# NM_MODULE_AUTH=1
# NM_MODULE_API_AUTH=1
# NM_MODULE_SYSLOG=1
# NM_MODULE_STATS=1
# NM_MODULE_REPUTATION=1
# INGEST_ALLOW_FROM=syslog-ng
# NM_TRUSTED_PROXIES=frontend
# NM_SYSLOG_ALLOW_FROM=10.0.0.0/8
# GEOIP_SNAPSHOT_FILE=off
