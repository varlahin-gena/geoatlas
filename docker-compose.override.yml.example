# Пример того, что генерирует ./scripts/tune-resources.sh для small (4 CPU / 8 GiB).
# Не копируйте вручную — лучше: NM_FORCE_PROFILE=small ./scripts/tune-resources.sh

services:
  clickhouse:
    deploy:
      resources:
        limits:
          cpus: "3.0"
          memory: 3g

  backend:
    environment:
      INGEST_WORKERS: "2"
      INGEST_BATCH_SIZE: "20000"
      INGEST_QUEUE_SIZE: "200000"
      INGEST_FLUSH_SEC: "1"
      CH_INGEST_MAX_OPEN_CONNS: "2"
      CH_INGEST_ASYNC_INSERT: "true"
      GOMAXPROCS: "2"
    deploy:
      resources:
        limits:
          cpus: "2.0"
          memory: 2g

  syslog-ng:
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: 768m
    # Буферы: syslog-ng.d/zz_profile.conf (fifo 25k, mem 64 MiB, disk 512 MiB)
