# Сгенерировано установщиком / tune-resources.sh
docker-compose.override.yml
.env
.env.*
!.env.example
.admin_password_once
install-profile.json
install-modules.json
install-meta.json
clickhouse/users.d/zz_install_limits.xml
syslog-ng.d/zz_profile.conf
syslog-ng.d/zz_ingest_auth.conf

# TLS (свои сертификаты) — ключи не коммитить
certs/*
!certs/.gitkeep
!certs/README.md

# Локальные инструменты разработки
.tmp/
.tmp_*
backend/.gotmp/
*.exe
*.test
__debug_bin*
coverage.out
coverage.html
*.prof
*.log

# Frontend build artifacts
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
